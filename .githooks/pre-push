#!/usr/bin/env bash
# Hook de git: no deja subir cambios si CLAUDE.md no se ha actualizado
# (ver tools/git/check_context.sh). Se activa una vez por copia con:
#   git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	# Borrar una rama remota no necesita comprobación.
	[ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
	"$root/tools/git/check_context.sh" "$remote_sha" "$local_sha" || status=1
done
exit $status
