# MAMÁ — la madre de Ren. Alegre, ruidosa, turnos largos; pregunta si ha comido.
# Ficha: src/data/characters/madre_ren.json

# =====================================================================================
# MÓVIL — Ren le escribe desde Contactos o Mensajes (solo saludo, de momento)
# =====================================================================================

~ madre_ren_movil
# cuando: movil
%
	Ren: Hola, mamá.
	Mamá: ¡Hola, cariño! ¿Has comido? Hay croquetas en el congelador.
%
	Ren: ¿Qué tal el turno?
	Mamá: Largo, pero bien. ¿Y ese mensajito? ¿Necesitas dinero o es que me quieres?
%
	Ren: Ey.
	Mamá: «Ey». Te he parido yo, ¿sabes? Un «hola, mamá» no cuesta tanto. Te quiero.
=> END

~ madre_ren_movil_otra_vez
# cuando: movil, veces >= 2
%
	Ren: Hola otra vez.
	Mamá: Dos mensajes en un día. Me voy a emocionar.
%
	Ren: ¿Sigues ahí?
	Mamá: Siempre, cariño. Estoy en el trabajo, luego te llamo.
=> END

~ madre_ren_movil_tras_incursion
# cuando: movil, fase >= incursion_1
Ren: Hola, mamá. ¿Estás bien?
Mamá: Sí, cariño. Han dicho en la radio que ha habido un problema en Leganés. ¿Tú estás bien? Ven a casa pronto, por favor.
=> END

# =====================================================================================
# EN CASA — desde el jueves (día 4) está por la mañana y por la noche (LocationDB
# «cast_when»). Solo se puede hablar con ella (CharacterDB «talk_only»).
# =====================================================================================

~ madre_ren_hablar
# cuando: hablar
if Story.franja() == "manana"
	%
		Mamá: ¡Buenos días! Hay café. Bueno, hay agua marrón. La cafetera está dando sus últimos coletazos.
		- Le doy un golpe, que funciona. [#bromista]
			Mamá: Tu padre le daba golpes también. Así está la pobre.
		- Te compro una por tu cumpleaños. [#cariñoso]
			Mamá: ¡Si mi cumpleaños es en julio! ...Apuntado, ¿eh? Que me acuerdo.
	%
		Mamá: ¿Has dormido algo? Te oí reírte a las dos de la mañana. Con el móvil.
		Ren: Era Kenji. Un audio.
		Mamá: Ese niño. Dile que se duerma, que tiene unas ojeras que da miedo.
	%
		Mamá: Me voy a trabajar en diez minutos. Si necesitas algo, me escribes. Y si no necesitas nada, me escribes también.
else
	%
		Mamá: ¿Qué tal el día, cariño? Cuéntame algo. Lo que sea. Algo que no sea «bien».
		- Rika me ha obligado a opinar sobre un vestido. [#bromista]
			Mamá: ¿Y opinaste bien? Porque eso es un examen, Ren. Es un examen.
		- He estado con los chicos. Muy bien. [#franco]
			Mamá: «Muy bien». Bueno, es más que «bien». Lo acepto.
	%
		Mamá: Estoy viendo la serie de los médicos. Hoy se ha casado uno con otra que estaba en coma. Ya no entiendo nada.
		Mamá: Siéntate un rato conmigo, anda. Te lo explico. O no te lo explico, que tampoco lo entiendo.
	%
		Mamá: Me he encontrado la gorra del Lega en tu estantería. La he dejado donde estaba, ¿eh? No toco nada.
		Mamá: Tu padre la llevaba hasta para dormir la siesta. Qué hombre.
		- Algún día me valdrá. [#cariñoso]
			Mamá: Ya te queda menos grande que el año pasado. Te lo digo yo, que lo veo.
		- Olía a palomitas, me acuerdo. [#franco]
			Mamá: ¡Siempre! Comía palomitas en el fútbol como si fuera el cine.
=> END

~ madre_ren_hablar_invita_cena
# cuando: hablar, flag por_proponer:cena_mama, flag dia_4, una vez
Mamá: Oye, esta noche cenamos juntos, ¿vale? Hago la tortilla de papá.
- Hecho. [#cariñoso]
	$> Story.plan_answer("cena_mama", "si")
	Mamá: ¡Bien! A las nueve y media.
- Ya he quedado para {{Story.conflict_title("cena_mama")}}, mamá. [#franco] [if Story.has_conflict("cena_mama") /]
	$> Story.plan_answer("cena_mama", "otro")
	Mamá: Ah. Pues otro día. Me alegro de que tengas planes.
- No sé si podré. [#evasivo]
	$> Story.plan_answer("cena_mama", "no")
	Mamá: Vale, vale. La tortilla aguanta.
=> END

~ madre_ren_hablar_plantado_cena
# cuando: hablar, flag reproche:cena_mama, flag plan_plantado:cena_mama, no flag plan_hecho:cena_mama, una vez
$> Story.set_flag("reproche:cena_mama", false)
Mamá: Buenos días.
Mamá: La tortilla está en la nevera. Tapada. No pasa nada, cariño, de verdad.
Mamá: Solo... la próxima vez avísame. Me quedé esperando con el mantel puesto como una tonta.
if Story.went_instead("cena_mama") != ""
	Mamá: Y me alegro de que estuvieras en {{Story.went_instead("cena_mama")}}, ¿eh? Me alegro de verdad. Pero avisa.
- Lo siento, mamá. Esta noche la cenamos. [#franco, #cariñoso]
	Mamá: ...Esta noche. Recalentada. Que está más buena, además.
	$> Story.change("madre_ren", "resentimiento", -3)
	$> Story.change("madre_ren", "afecto", 2)
- Se me fue el santo al cielo. [#evasivo]
	Mamá: Ya. A tu padre también se le iba. Siempre al mismo cielo, además.
	$> Story.change("madre_ren", "confianza", -1)
=> END

~ madre_ren_hablar_tras_cena
# cuando: hablar, flag plan_hecho:cena_mama, una vez
Mamá: Anoche, después de cenar, me quedé un rato mirando fotos. De las buenas, ¿eh? No de las tristes.
Mamá: Hay una de papá y tú en la playa con un cubo en la cabeza. Tú tenías cuatro años. Él, cuarenta.
- ¿Quién llevaba el cubo? [#bromista]
	Mamá: Los dos. Cada uno el suyo. Ahí empezó todo.
- Me la quiero quedar. [#cariñoso]
	Mamá: Te la imprimo. Y otra para la entrada, al lado de la que ya hay.
	$> Story.change("madre_ren", "afecto", 2)
=> END

~ madre_ren_harto_hablar
# cuando: harto_hablar
Mamá: Cariño, te quiero mucho, pero tengo que acabar esto. Luego hablamos, ¿vale?
=> END

~ madre_ren_no_quiere
# cuando: no_quiere
Mamá: Hoy estoy hecha polvo, cariño. Mañana te escucho todo lo que quieras.
=> END

# --- Planes: respuestas por el móvil y plantones (Invites) --------------------------

~ madre_ren_movil_plan
if Story.plan_reply() == "si"
	Ren: Esta noche ceno contigo, mamá.
	Mamá: ¡Bien! Me pongo el mandil bueno.
elif Story.plan_reply() == "otro"
	Ren: Esta noche no puedo, mamá. He quedado para {{Story.other_plan_title()}}.
	Mamá: ¡Uy, qué social! Me alegro, cariño. Otra noche.
else
	Ren: Esta noche igual no llego, mamá.
	Mamá: Vale. Tú pásalo bien. Pero avisa.
=> END

~ madre_ren_movil_plantado
if Story.plan_reply() == "perdon"
	Ren: Lo siento, mamá. Mañana la cenamos.
	Mamá: Mañana. Recalentada, que está más buena. Te quiero, pesado.
elif Story.plan_reply() == "otro"
	Ren: Estaba en {{Story.other_plan_title()}}. Tenía que haberte avisado.
	Mamá: Me alegro de que salieras, de verdad. Pero un mensaje, Ren. Uno. Que me preocupo.
else
	Ren: Se me olvidó, mamá.
	Mamá: Ya. Bueno. A tu padre también se le olvidaban las cosas. Pero las cenas nunca.
=> END

# --- Planes que propone Ren (Invites.ren_invite) -----------------------------------

~ madre_ren_quedar
Ren: Mamá, ¿te apetece {{Story.plan_title()}} {{Story.plan_when()}}?
if Story.plan_reply() == "si"
	Mamá: ¿Conmigo? ¿Mi hijo me invita a algo? ¡Ay, que me da algo! Sí, sí, sí.
	if Story.other_guests("madre_ren") != ""
		Mamá: ¿Y viene {{Story.other_guests("madre_ren")}}? ¡Qué bien! Prometo no avergonzarte. Mucho.
elif Story.plan_reply() == "ocupado"
	Mamá: Ay, cariño, a esa hora ya tengo {{Story.other_plan_title()}}. ¿Otro día?
elif Story.plan_reply() == "ya"
	Mamá: Que sí, que ya me lo has dicho. Lo tengo en el calendario de la nevera.
else
	Mamá: Hoy estoy molida, cariño. Pero gracias por pensar en mí.
=> END

~ madre_ren_quedada
if Story.activity() == "recreativas"
	Mamá: ¡Yo era la reina del Tetris! En el ochenta y... bueno, hace mucho.
	Mamá gana a todo el mundo en el de baile. Todo el mundo la aplaude. Tú quieres que te trague la tierra y a la vez estás orgulloso.
elif Story.activity() == "cine"
	Mamá llora en una película que no es triste. Luego te lo niega.
elif Story.activity() == "voley"
	Mamá: Yo jugaba de líbero en el instituto. ¡Pásamela!
	Se tira al suelo a por una pelota imposible. La saca. Se queda tumbada en la hierba riéndose.
else
	Mamá: Esto hay que hacerlo más, cariño. Tú y yo. Como cuando eras pequeño.
if Story.present("kenji")
	Kenji: Tu madre es una leyenda, Ren. Una leyenda.
- Gracias por venir, mamá. [#cariñoso]
	Mamá: ¿Gracias? Gracias a ti, tonto. Me has alegrado la semana.
	$> Story.change("madre_ren", "afecto", 2)
- La próxima no me avergüences tanto. [#bromista]
	Mamá: Ni lo sueñes. Es mi derecho de madre.
=> END

~ madre_ren_hablar_plantado
if Story.plan_is_ren()
	Mamá: Cariño, ayer me propusiste {{Story.plan_title()}}. Me arreglé y todo. Te estuve esperando.
else
	Mamá: Lo de {{Story.plan_title()}}... Te estuve esperando.
Mamá: No pasa nada, ¿eh? Pero la próxima me escribes. Me preocupo.
- Lo siento, mamá. [#franco, #cariñoso]
	Mamá: Ya está. Ven aquí. (Te da un abrazo que te aplasta.)
	$> Story.change("madre_ren", "resentimiento", -3)
- Se me pasó. [#evasivo]
	Mamá: Ya. A tu padre también se le pasaban cosas. Pero me avisaba.
	$> Story.change("madre_ren", "confianza", -1)
=> END
